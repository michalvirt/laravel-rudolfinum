# --- Závislosti & Balíčky ---
/node_modules
/vendor

# --- Buildy a zkompilované frontendové assety ---
/public/build
/public/hot
/public/storage
dist/
build/
*.tsbuildinfo

# --- Laravel Cache, Session a dočasné soubory ---
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/bootstrap/cache/*

# --- Logy a debug ---
/storage/logs/*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Obří lockfily (ušetří desítky tisíc tokenů) ---
package-lock.json
composer.lock
yarn.lock
pnpm-lock.yaml
bun.lockb

# --- Databáze a lokální storage ---
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
/storage/app/*
!/storage/app/.gitignore

# --- Testy a pokrytí kódu ---
.phpunit.result.cache
.phpunit.cache
coverage/
.nyc_output/

# --- IDE, OS & Git ---
.git/
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Citlivé konfigurační soubory (bezpečnost + tokeny) ---
.env
.env.*
!.env.example
