APP_NAME=Laravel
APP_KEY=
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# Docker passes environment values as strings. Use 0 and 1 so PHP does not treat the word "false" as true.
APP_DEBUG=0

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=rudolfinum
DB_USERNAME=rudolfinum
DB_PASSWORD=

HTTP_PORT=8080

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=0

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

INERTIA_SSR_ENABLED=1
INERTIA_SSR_URL=http://ssr:13714
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=0

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
